# Server port
PORT=3000

# OAuth 2.0 credentials for Gemini Web App (gemini.google.com/devmode)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Optional: Protect /mcp with a static Bearer token
MCP_AUTH_TOKEN=

# Browser settings
# Set to "false" to watch the browser window locally; keep "true" for Docker/headless
HEADLESS=true

# Optional: Attach to an existing Chrome instance started with --remote-debugging-port=9222
# Example: CDP_ENDPOINT=http://127.0.0.1:9222
CDP_ENDPOINT=

# Firecrawl API key (get one at https://firecrawl.dev or point FIRECRAWL_API_URL to a self-hosted instance)
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
