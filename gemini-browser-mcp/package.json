{
  "name": "gemini-browser-mcp",
  "version": "1.0.0",
  "description": "Streamable HTTP MCP server for Gemini Web App combining Playwright browser control, Chrome DevTools (CDP), and Firecrawl.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "tunnel": "cloudflared tunnel --url http://localhost:3000"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@mozilla/readability": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.52.0",
    "turndown": "^7.2.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
