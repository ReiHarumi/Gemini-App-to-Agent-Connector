{
  "manifest_version": 3,
  "name": "Gemini Agent Relay Bridge",
  "version": "2.2.1",
  "description": "Automatically triggers pending agent-relay-mcp tasks in parallel across Gemini Web App tabs.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:3001/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gemini Agent Relay Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
