# Server port (3001 so it runs cleanly alongside gemini-browser-mcp on 3000)
PORT=3001

# Public HTTPS base URL for generated media links (e.g. your Tailscale Funnel /relay URL)
PUBLIC_BASE_URL=https://your-machine.your-tailnet.ts.net/relay

# Read-only root folder accessible by Gemini Web App via relay_request_local_files
LOCAL_FILES_ROOT=

# Output directory for generated images, videos, and music (defaults to ../generated-media)
GENERATED_MEDIA_DIR=

# OAuth 2.0 credentials for Gemini Web App (gemini.google.com/devmode)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Optional static Bearer token fallback
MCP_AUTH_TOKEN=
